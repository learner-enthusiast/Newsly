# --- Dependencies & install artifacts (~2GB+; never edit by hand) ---
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Next.js build output (~hundreds of MB; regenerated) ---
.next/
out/
build/

# --- Prisma generated client (source of truth: db/schema/*.prisma) ---
db/generated/

# --- Secrets & local auth cache (must not enter AI context) ---
.env
.env.*
!.env.example
.clerk/

# --- Vercel / deploy ---
.vercel/

# --- Test & coverage output ---
coverage/

# --- Logs & debug ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- OS & keys ---
.DS_Store
Thumbs.db
*.pem

# --- TypeScript / Next auto-generated ---
*.tsbuildinfo
next-env.d.ts

# --- Git (object store; not your app source) ---
.git/

# --- Optional: lockfile (~9k lines; ignore unless you are changing deps) ---
# pnpm-lock.yaml