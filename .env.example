# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/myapp

# OpenAI Platform (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: only if you use a non-default endpoint or OpenAI project scoping
# OPENAI_BASE_URL=
# OPENAI_PROJECT_ID=
# Optional per-agent overrides (else OPENAI_MODEL, else gpt-4o-mini)
# DETERMINER_MODEL=
# GUARDRAIL_MODEL=
# RESEARCH_ARTICLE_SELECTOR_MODEL=
# NEWS_SYNTHESIZER_MODEL=
# NEWS_NEW_CHAT_MODEL=
# CHAT_MODEL=
# QUERY_ENHANCER_MODEL=

# Vercel AI SDK (optional fallback when using AIClient)
AI_GATEWAY_API_KEY=
AI_MODEL=

# Firecrawl
FIRECRAWL_API_KEY=

# SerpApi
SERPAPI_API_KEY=

# Inngest
INNGEST_DEV=1
INNGEST_APP_ID=
INNGEST_EVENT_KEY=
