# =============================================================================
# Environment template (copy to `.env` on your machine or server — never commit)
#
# Local:  cp .env.example .env  →  pnpm dev  +  pnpm inngest:dev (terminal 2)
# Prod:   same file on the host; use production keys and URLs below.
#
# NODE_ENV is set by Next.js (`development` for `pnpm dev`, `production` for
# `pnpm build` + `pnpm start`). Do not set NODE_ENV in this file.
#
# Validated at startup: clients/env.ts (required keys for the web app to boot).
#
# One-time after migrate (see README):
#   pnpm news:metros:seed          — news location metros
#   pnpm instruments:sync          — stock/ETF search (optional)
#   pnpm system-user:seed          — only if using SYSTEM_USER_ID (optional; see below)
# =============================================================================

# =============================================================================
# Required — server fails to start if any of these are missing (see clients/env.ts)
# =============================================================================

# Clerk (https://dashboard.clerk.com) — use Development keys locally, Production on live site
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Database (local Docker: docker compose up -d → port 5434)
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/myapp
# DB_URL=                        # optional alias for DATABASE_URL

# OpenAI (https://platform.openai.com/api-keys) — chat, agents, embeddings
OPENAI_API_KEY=

# Research pipelines
FIRECRAWL_API_KEY=
SERPAPI_API_KEY=

# =============================================================================
# Newsletters (optional for app boot — required to send / schedule digests)
# lib/newsletter/systemUser.ts · lib/email/resendClient.ts
# =============================================================================

RESEND_API_KEY=
# From: must be @ your Resend-verified domain (e.g. dainikjagaran.arnabsamanta.in)
EMAIL_FROM=Dainik Jagaran <digest@dainikjagaran.arnabsamanta.in>

# Links inside emails (stories, manage, unsubscribe). No trailing slash.
APP_URL=http://localhost:3000
# APP_URL=https://dainikjagaran.arnabsamanta.in
# NEXT_PUBLIC_APP_URL=

# Who owns shared edition NewsRequests (Postgres users.id — not Clerk id in the DB).
# Set exactly ONE; if both are set, SYSTEM_USER_CLERK_ID wins.
#
# Local dev (recommended): Clerk Dashboard → Users → copy user id, sign in to the app once.
SYSTEM_USER_CLERK_ID=
# Prod / headless: internal cuid; row auto-created on first newsletter run.
# SYSTEM_USER_ID=

UNSUBSCRIBE_SECRET=
# Generate: openssl rand -hex 32

# Upstox Analytics Token (stock research / market data — Developer Apps → Analytics)
# Server-side only; never expose to the browser or client bundles.
UPSTOX_ANALYTICS_TOKEN=
# Optional: force HTTP fallback client instead of upstox-js-sdk (debug/tests)
# UPSTOX_USE_HTTP_FALLBACK=true

# =============================================================================
# Optional — warnings at startup with documented defaults (clients/env.ts)
# =============================================================================

# Clerk routes. Sign-in/up is modal-only: these point at / where
# ClerkModalBridge opens the modal and handles #/sso-callback.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/home
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/home

# OpenAI defaults
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=
# OPENAI_PROJECT_ID=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_STRUCTURED_RETRY_MODEL=

# Per-agent model overrides (else OPENAI_MODEL, else gpt-4o-mini; synthesizer default gpt-5.4-mini)
# DETERMINER_MODEL=
# GUARDRAIL_MODEL=
# CHAT_MODEL=
# QUERY_ENHANCER_MODEL=
# NEWS_NEW_CHAT_MODEL=
# NEWS_SYNTHESIZER_MODEL=gpt-5.4-mini
# RESEARCH_ARTICLE_SELECTOR_MODEL=
# NEWS_CONTENT_CLEANER_MODEL=
# GAI_OVERVIEW_SEARCH_MODEL=
# YOUTUBE_VIDEO_AGENT_MODEL=
# YOUTUBE_TRANSCRIPT_AGENT_MODEL=
# YOUTUBE_TRANSCRIPT_SYNTHESIZE_MODEL=
# RESEARCH_SOURCE_DESCRIPTION_MODEL=
# CHAT_MESSAGE_SUMMARIZER_VECTOR_MODEL=
# CHAT_SESSION_TITLE_MODEL=
# CHAT_STORY_RESEARCH_GAP_MODEL=
# CHAT_STORY_SIMILARITY_QUERY_MODEL=
# POTENTIAL_STORY_TOPIC_MODEL=
# CHAT_STORY_IDENTIFIER_MODEL=
# RELEVANCE_AGENT_MODEL=
# QUICK_ACTION_AGENT_MODEL=
# TRY_THESE_QUESTIONS_MODEL=
# STOCK_RESEARCH_TOOL_DETERMINER_MODEL=
# STOCK_RESEARCH_PROMPT_ENHANCER_MODEL=
# STOCK_RESEARCH_LINK_SELECTOR_MODEL=
# STOCK_RESEARCH_SYNTHESIZER_MODEL=
# INSTRUMENT_DETERMINER_MODEL=

# Vercel AI SDK gateway (optional; used when OPENAI is not the primary path in AIClient)
AI_GATEWAY_API_KEY=
AI_MODEL=inclusionai/ling-3.0-flash-sante-free

# SerpAPI
# SERPAPI_TIMEOUT_MS=

# Newsletter editions older than this many days are deleted daily, except those
# with saved/voted/chat-linked stories (default 365)
# NEWSLETTER_EDITION_RETENTION_DAYS=365

# Neatlogs tracing (https://docs.neatlogs.com/sdk/typescript)
# Export stays off when the key is unset. EU projects set the EU ingest base URL.
# NEATLOGS_API_KEY=
# NEATLOGS_WORKFLOW_NAME=dainik-samachar
# NEATLOGS_ENDPOINT=https://ingest.neatlogs.com
# NEATLOGS_ENDPOINT=https://eu.ingest.neatlogs.com
# NEATLOGS_DEBUG=false
# true also exports traceLog() lines (e.g. Upstox retries) onto spans
# NEATLOGS_CAPTURE_LOGS=false
# Dev only: also append every exported span to this JSONL file (see pnpm trace:print)
# NEATLOGS_LOCAL_SPAN_LOG=/tmp/neatlogs-spans.jsonl
# Commit recorded on every trace (falls back to `git rev-parse`)
# GIT_SHA=
# Override LLM prices (USD per 1M tokens) used for per-run cost
# LLM_PRICES_JSON={"gpt-4o-mini":{"input":0.15,"output":0.6}}

# =============================================================================
# Inngest — durable workflows served at /api/inngest (see inngest/index.ts)
#
# Local (recommended):
#   INNGEST_DEV=1
#   Run `pnpm inngest:dev` alongside `pnpm dev`.
#
# Production (Inngest Cloud — recommended for a public deploy):
#   Omit INNGEST_DEV or set INNGEST_DEV=0
#   INNGEST_EVENT_KEY=evt_...
#   INNGEST_SIGNING_KEY=signkey-prod-...
#   Register app URL in Inngest dashboard:
#   https://<your-domain>/api/inngest
#
# Production (self-hosted dev server — legacy single-host setup in README):
#   INNGEST_DEV=1 plus a reachable Inngest dev server (INNGEST_BASE_URL if not default)
# =============================================================================
INNGEST_DEV=1
INNGEST_APP_ID=my-app
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=
# INNGEST_SIGNING_KEY_FALLBACK=
# INNGEST_BASE_URL=http://localhost:8288

# Public GitHub repo for feature requests (optional; has a default in lib/githubLinks.ts)
# NEXT_PUBLIC_GITHUB_REPO_URL=https://github.com/your-org/your-repo

# Razorpay (test mode keys locally — live keys only on production checkout)
# Key ID + secret must be the same pair from Dashboard → API Keys (Test/Live mode must match).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional; if set, must be identical to RAZORPAY_KEY_ID (otherwise Standard Checkout returns 401).
# NEXT_PUBLIC_RAZORPAY_KEY_ID=
# RAZORPAY_WEBHOOK_SECRET=          # optional; defaults to RAZORPAY_KEY_SECRET
# BILLING_PRO_MONTHLY_PAISE=19900     # optional; amount in paise (₹199)

# Photo upload — Cloudinary primary, S3 fallback (clients/photoUploadClient.ts)
# Used by POST /api/news/stories/[storyId]/photo. Warns at startup if neither stack is set.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=
# NEWS_STORY_PHOTO_FOLDER=newsly/stories
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_S3_REGION=                  # optional alias for AWS_REGION
# AWS_S3_KEY_PREFIX=
# AWS_S3_PUBLIC_URL_BASE=
