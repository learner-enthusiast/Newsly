      "id": "livemint-india",
      "name": "Mint",
      "kind": "rss",
      "urls": [
        "https://www.livemint.com/rss/news"
      ],
      "pathIncludes": [
        "/news/india/"
      ],
      "enabled": true
    },
    {
      "id": "economic-times",
      "name": "The Economic Times",
