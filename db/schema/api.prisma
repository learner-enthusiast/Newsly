/// Public REST API (v1) keys. Only the SHA-256 of the full key is stored.
model ApiKey {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id")

  /// User-given label, e.g. "Trading bot".
  name String

  /// First 12 chars of the key (`ds_live_xxxx`), shown in the UI.
  prefix String @unique

  /// Hex SHA-256 of the full key; the full key is never stored.
  hashedKey String @unique @map("hashed_key")

  scopes String[] @default([])

  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestLogs ApiRequestLog[]
  jobs        ApiJob[]

  @@index([userId, revokedAt])
  @@map("api_keys")
}

/// One row per v1 request: usage page, quotas and debugging.
model ApiRequestLog {
  id String @id @default(uuid()) @db.Uuid

  apiKeyId String @map("api_key_id") @db.Uuid
  userId   String @map("user_id")

  method     String
  path       String
  status     Int
  durationMs Int    @map("duration_ms")
  /// `read` | `search` | `pipeline`
  costClass  String @map("cost_class")
  requestId  String @map("request_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([apiKeyId, createdAt])
  @@index([userId, createdAt])
  @@map("api_request_logs")
}

/// Sliding-window rate limiter buckets (`PostgresRateLimiter`). One row per
/// key per minute; rows older than 2 days are deleted by a daily cron.
model ApiRateLimitWindow {
  bucket      String
  windowStart DateTime @map("window_start") @db.Timestamptz(6)
  count       Int      @default(0)

  @@id([bucket, windowStart])
  @@index([windowStart])
  @@map("api_rate_limit_windows")
}

/// `Idempotency-Key` records for pipeline POSTs, kept 24h.
model ApiIdempotencyKey {
  id String @id @default(uuid()) @db.Uuid

  userId      String @map("user_id")
  key         String
  method      String
  path        String
  /// SHA-256 of method + path + canonical JSON body.
  requestHash String @map("request_hash")

  /// Null while the first request is still running.
  responseStatus Int?  @map("response_status")
  responseBody   Json? @map("response_body")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([createdAt])
  @@map("api_idempotency_keys")
}

/// An async pipeline request accepted (or deduplicated) by the API. Status is
/// never stored here: it is read live from the underlying record.
model ApiJob {
  id String @id @default(uuid()) @db.Uuid

  userId   String @map("user_id")
  apiKeyId String @map("api_key_id") @db.Uuid

  /// `briefing` | `research`
  type       String
  /// `NewsRequest.id` (briefing) or `StockResearch.id` (research).
  resourceId String @map("resource_id")

  /// SHA-256 of the canonical request body.
  requestHash  String  @map("request_hash")
  /// True when the request matched an existing briefing (no new pipeline, no quota).
  deduplicated Boolean @default(false)

  webhookUrl         String?   @map("webhook_url")
  /// `pending` | `delivered` | `failed` | `expired`; null without a webhook.
  webhookStatus      String?   @map("webhook_status")
  webhookAttempts    Int       @default(0) @map("webhook_attempts")
  webhookDeliveredAt DateTime? @map("webhook_delivered_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([type, resourceId])
  @@map("api_jobs")
}

/// Per-user HMAC secret for signing webhooks. Shown and rotated on the
/// Developers page; stored in clear because it is needed to sign.
model ApiWebhookSecret {
  userId    String   @id @map("user_id")
  secret    String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  rotatedAt DateTime? @map("rotated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_webhook_secrets")
}
