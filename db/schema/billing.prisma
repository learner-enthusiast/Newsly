enum UserPlan {
  FREE
  PRO

  @@map("user_plan")
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELLED
  EXPIRED

  @@map("subscription_status")
}

enum PaymentStatus {
  CREATED
  PENDING
  SUCCESS
  FAILED
  REFUNDED

  @@map("payment_status")
}

enum WebhookEventStatus {
  PENDING
  PROCESSED
  FAILED

  @@map("webhook_event_status")
}

model Subscription {
  id String @id @default(uuid()) @db.Uuid

  userId String @unique @map("user_id")

  plan UserPlan

  status SubscriptionStatus @default(ACTIVE)

  provider               String
  providerCustomerId     String? @map("provider_customer_id")
  providerSubscriptionId String? @unique @map("provider_subscription_id")

  currentPeriodStart DateTime? @map("current_period_start")
  currentPeriodEnd   DateTime? @map("current_period_end")

  cancelAtPeriodEnd Boolean @default(false) @map("cancel_at_period_end")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("subscriptions")
}

model Payment {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id")

  /// Amount in smallest currency unit (e.g. paise for INR).
  amount   Int
  currency String @default("INR")

  provider String

  providerOrderId   String? @map("provider_order_id")
  providerPaymentId String? @unique @map("provider_payment_id")

  status PaymentStatus

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([providerOrderId])
  @@map("payments")
}

model PaymentWebhookEvent {
  id String @id @default(uuid()) @db.Uuid

  provider String

  eventId   String @map("event_id")
  eventType String @map("event_type")

  processedAt DateTime? @map("processed_at")

  status WebhookEventStatus @default(PENDING)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([provider, eventId])
  @@index([provider])
  @@index([status])
  @@map("payment_webhook_events")
}
