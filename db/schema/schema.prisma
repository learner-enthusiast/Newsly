// Prisma loads every file in db/schema automatically.

generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String    @id @default(cuid())
  clerkId               String    @unique
  email                 String    @unique
  firstName             String?
  lastName              String?
  username              String?
  imageUrl              String?
  hasImage              Boolean   @default(false)
  primaryEmailAddressId String?
  lastSignInAt          DateTime?
  lastActiveAt          DateTime?
  banned                Boolean   @default(false)
  locked                Boolean   @default(false)
  twoFactorEnabled      Boolean   @default(false)
  locale                String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  savedStories          String[]  @default([]) @map("saved_stories") @db.Uuid
  plan                  UserPlan  @default(FREE)

  newsRequests     NewsRequest[]
  chatSessions     ChatSession[]
  scripts          Script[]
  newsStoryVotes   NewsStoryVote[]
  notifications    Notification[]
  ownedNewsStories NewsStory[]
  subscription     Subscription?
  payments         Payment[]
  stockResearches  StockResearch[]
  newsletters      Newsletter[]
  apiKeys          ApiKey[]
  apiRequestLogs   ApiRequestLog[]
  apiIdempotencyKeys ApiIdempotencyKey[]
  providerUsage    ProviderUsage[]

  @@map("users")
}

enum NewsScope {
  local
  world
  both

  @@map("news_scope")
}

enum NewsRequestStatus {
  pending
  failed
  success

  @@map("news_request_status")
}

enum PublishStatus {
  draft
  published

  @@map("publish_status")
}

enum NewsletterFrequency {
  DAILY
  WEEKDAYS
  WEEKLY
  MONTHLY

  @@map("newsletter_frequency")
}

enum NewsletterDeliveryStatus {
  PENDING
  SENDING
  SENT
  FAILED
  SKIPPED

  @@map("newsletter_delivery_status")
}

enum NewsEditionStatus {
  PENDING
  BUILDING
  READY
  FAILED

  @@map("news_edition_status")
}

model NewsRequest {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String            @map("user_id")
  date        DateTime          @db.Date
  location    String?
  latitude    Float?
  longitude   Float?
  scope       NewsScope
  searchQuery Json              @map("search_query")
  status      NewsRequestStatus
  error       String?           @db.Text
  storyCount  Int               @default(5) @map("story_count")
  categories  String[]          @default([])
  customQuery String?           @map("custom_query") @db.Text
  language    String?
  sources     String[]          @default([])
  createdAt   DateTime          @default(now()) @map("created_at")
  completedAt DateTime?         @map("completed_at")
  isRerunning Boolean           @default(false) @map("is_rerunning")
  isEdition   Boolean           @default(false) @map("is_edition")
  newsEdition NewsEdition?

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  stories     NewsStory[]
  loadingLogs String[]    @default([]) @map("loading_logs")

  @@index([userId])
  @@index([status])
  @@index([date])
  @@map("news_requests")
}

model NewsStory {
  id              String        @id @default(uuid()) @db.Uuid
  newsRequestId   String?       @map("news_request_id") @db.Uuid
  chatSessionId   String?       @map("chat_session_id") @db.Uuid
  ownerId         String?       @map("owner_id")
  isUserCreated   Boolean       @default(false) @map("is_user_created")
  publishStatus   PublishStatus @default(published) @map("publish_status")
  generationError String?       @map("generation_error") @db.Text
  title           String
  description     String?
  slug            String
  summary         String        @db.Text
  content         String        @db.Text
  category        String
  location        String?
  publishedAt     DateTime?     @map("published_at")
  importanceScore Decimal?      @map("importance_score") @db.Decimal(10, 4)
  rank            Int?
  upvotes         Int           @default(0)
  downvotes       Int           @default(0)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  newsSourceIds   String[]      @default([]) @map("news_source_ids") @db.Uuid
  imageUrl        String?       @map("image_url") @db.Text
  loadingLogs     String[]      @default([]) @map("loading_logs")

  newsRequest       NewsRequest?    @relation(fields: [newsRequestId], references: [id], onDelete: Cascade)
  originChatSession ChatSession?    @relation("ChatStoryOrigin", fields: [chatSessionId], references: [id], onDelete: SetNull)
  owner             User?           @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  sources           NewsSource[]
  chatSessions      ChatSession[]   @relation("ChatSessionLinkedStory")
  votes             NewsStoryVote[]

  @@unique([newsRequestId, slug])
  @@index([newsRequestId])
  @@index([newsRequestId, rank])
  @@index([chatSessionId])
  @@index([ownerId])
  @@index([isUserCreated, publishStatus])
  @@index([ownerId, publishStatus])
  @@index([upvotes, publishedAt])
  @@map("news_stories")
}

model NewsSource {
  id             String    @id @default(uuid()) @db.Uuid
  newsStoryId    String    @map("news_story_id") @db.Uuid
  url            String    @db.Text
  domain         String
  title          String
  scrapedContent String?   @map("scraped_content") @db.Text
  publishedAt    DateTime? @map("published_at")
  sourceType     String    @map("source_type")
  createdAt      DateTime  @default(now()) @map("created_at")
  transcript     String?   @db.Text
  imageUrl       String?   @map("image_url") @db.Text

  newsStory NewsStory @relation(fields: [newsStoryId], references: [id], onDelete: Cascade)

  @@index([newsStoryId])
  @@map("news_sources")
}

enum VoteType {
  UP
  DOWN

  @@map("vote_type")
}

model NewsStoryVote {
  id          String @id @default(uuid()) @db.Uuid
  newsStoryId String @map("news_story_id") @db.Uuid
  userId      String @map("user_id")

  vote VoteType

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  newsStory NewsStory @relation(fields: [newsStoryId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([newsStoryId, userId])
  @@index([newsStoryId])
  @@index([userId])
  @@map("news_story_votes")
}

model ChatSession {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id")
  newsStoryId      String?  @map("news_story_id") @db.Uuid
  newsSourceId     String[] @default([]) @map("news_source_id") @db.Uuid
  title            String?
  topic            String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  isFromNewsStory  Boolean  @default(false) @map("is_from_news_story")
  isBookmarked     Boolean  @default(false) @map("is_bookmarked")
  potentialStories String[] @default([]) @map("potential_stories")

  user               User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  newsStory          NewsStory?              @relation("ChatSessionLinkedStory", fields: [newsStoryId], references: [id], onDelete: SetNull)
  originStories      NewsStory[]             @relation("ChatStoryOrigin")
  messages           ChatMessage[]
  researchSources    ResearchSource[]
  scripts            Script[]
  resourceEmbeddings ChatResourceEmbedding[]
  messageEmbeddings  ChatMessageEmbedding[]

  @@index([userId])
  @@index([userId, isBookmarked])
  @@index([newsStoryId])
  @@map("chat_sessions")
}

model ChatMessage {
  id            String   @id @default(uuid()) @db.Uuid
  chatSessionId String   @map("chat_session_id") @db.Uuid
  role          String
  content       String   @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  scriptId      String?  @map("script_id") @db.Uuid
  loadingLogs   String[] @default([]) @map("loading_logs")
  isAStoryRequest Boolean @default(false) @map("is_a_story_request")
  newsStoryId     String? @map("news_story_id") @db.Uuid
  isRerunning     Boolean @default(false) @map("is_rerunning")

  chatSession ChatSession           @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)
  embedding   ChatMessageEmbedding?

  @@index([chatSessionId])
  @@index([chatSessionId, createdAt, id])
  @@map("chat_messages")
}

model ResearchSource {
  id            String   @id @default(uuid()) @db.Uuid
  chatSessionId String   @map("chat_session_id") @db.Uuid
  url           String   @db.Text
  domain        String
  title         String
  description   String?
  content       String   @db.Text
  sourceType    String   @map("source_type")
  imageUrl      String?  @map("image_url") @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  chatSession       ChatSession            @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)
  resourceEmbedding ChatResourceEmbedding?

  @@index([chatSessionId])
  @@map("research_sources")
}

model ChatResourceEmbedding {
  id             String                      @id @db.Uuid
  chatSessionId  String                      @map("chat_session_id") @db.Uuid
  chatResourceId String                      @unique @map("chat_resource_id") @db.Uuid
  embedding      Unsupported("vector(1536)")

  chatSession    ChatSession    @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)
  researchSource ResearchSource @relation(fields: [chatResourceId], references: [id], onDelete: Cascade)

  @@index([chatSessionId])
  @@map("chat_resource_embeddings")
}

model Script {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id")
  chatSessionId     String   @map("chat_session_id") @db.Uuid
  title             String
  content           String   @db.Text
  durationSeconds   Int?     @map("duration_seconds")
  style             String?
  status            String
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  researchSourceIds String[] @default([]) @map("research_source_ids") @db.Uuid

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatSession ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([chatSessionId])
  @@map("scripts")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id")
  type      String
  title     String
  message   String?
  link      String?
  read      Boolean  @default(false)
  dedupeKey String?  @map("dedupe_key")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@index([userId, read])
  @@map("notifications")
}

model ChatMessageEmbedding {
  id            String                      @id @default(uuid()) @db.Uuid
  messageId     String                      @unique @map("message_id") @db.Uuid
  chatSessionId String                      @map("chat_session_id") @db.Uuid
  embedding     Unsupported("vector(1536)")
  createdAt     DateTime                    @default(now()) @map("created_at")

  message     ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  chatSession ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)

  @@index([chatSessionId])
  @@map("chat_message_embeddings")
}

model SearchAutocompleteCache {
  id        String   @id @default(uuid()) @db.Uuid
  provider  String
  query     String
  response  Json
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  @@unique([provider, query])
  @@index([expiresAt])
  @@map("search_autocomplete_cache")
}

/// Curated metros for local news location (seeded from config/newsMetros.ts).
model NewsMetro {
  id          String   @id
  name        String
  aliases     String[] @default([])
  country     String
  countryCode String   @map("country_code")
  region      String
  latitude    Float
  longitude   Float
  timezone    String
  lang        String

  @@index([name], map: "idx_news_metros_name")
  @@map("news_metros")
}

model Newsletter {
  id                String               @id @default(cuid())
  userId            String               @map("user_id")
  name              String
  email             String
  isActive          Boolean              @default(true) @map("is_active")
  location          String?
  latitude          Float?
  longitude         Float?
  scope             NewsScope
  storyCount        Int                  @map("story_count")
  categories        String[]             @default([])
  customQuery       String?              @map("custom_query") @db.Text
  language          String?
  sources           String[]             @default([])
  frequency         NewsletterFrequency
  sendTimeLocal     String               @map("send_time_local")
  timezone          String
  dayOfWeek         Int?                 @map("day_of_week")
  dayOfMonth        Int?                 @map("day_of_month")
  paramsFingerprint String               @map("params_fingerprint")
  nextRunAt         DateTime?            @map("next_run_at") @db.Timestamptz(6)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NewsletterDelivery[]

  @@index([userId])
  @@index([isActive, nextRunAt])
  @@index([paramsFingerprint])
  @@map("newsletters")
}

model NewsletterDelivery {
  id           String                   @id @default(uuid()) @db.Uuid
  newsletterId String                   @map("newsletter_id")
  scheduledFor DateTime                 @map("scheduled_for") @db.Timestamptz(6)
  status       NewsletterDeliveryStatus @default(PENDING)
  editionId    String?                  @map("edition_id") @db.Uuid
  storyCount   Int?                     @map("story_count")
  sentAt       DateTime?                @map("sent_at") @db.Timestamptz(6)
  error        String?                  @db.Text
  resendId     String?                  @map("resend_id")
  createdAt    DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  newsletter Newsletter   @relation(fields: [newsletterId], references: [id], onDelete: Cascade)
  edition    NewsEdition? @relation(fields: [editionId], references: [id], onDelete: SetNull)

  @@unique([newsletterId, scheduledFor])
  @@index([editionId])
  @@index([status])
  @@map("newsletter_deliveries")
}

model NewsEdition {
  id               String            @id @default(uuid()) @db.Uuid
  fingerprint      String
  periodKey        String            @map("period_key")
  newsRequestId    String            @unique @map("news_request_id") @db.Uuid
  status           NewsEditionStatus @default(PENDING)
  targetStoryCount Int               @map("target_story_count")
  builtStoryCount  Int               @default(0) @map("built_story_count")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  newsRequest NewsRequest            @relation(fields: [newsRequestId], references: [id], onDelete: Cascade)
  deliveries  NewsletterDelivery[]

  @@unique([fingerprint, periodKey])
  @@index([status])
  @@map("news_editions")
}

/// Upstox BOD instruments — one row per instrument_key; derivative-only columns are nullable.
model Instrument {
  instrumentKey  String  @id @map("instrument_key")
  segment        String
  exchange       String
  instrumentType String  @map("instrument_type")
  tradingSymbol  String  @map("trading_symbol")
  name           String
  exchangeToken  String  @map("exchange_token")

  isin         String?
  shortName    String? @map("short_name")
  securityType String? @map("security_type")

  lotSize        Int?     @map("lot_size")
  freezeQuantity Decimal? @map("freeze_quantity") @db.Decimal
  tickSize       Decimal? @map("tick_size") @db.Decimal

  expiry           DateTime? @db.Timestamptz(6)
  strikePrice      Decimal?  @map("strike_price") @db.Decimal
  weekly           Boolean?
  minimumLot       Int?      @map("minimum_lot")
  underlyingSymbol String?   @map("underlying_symbol")
  underlyingKey    String?   @map("underlying_key")
  underlyingType   String?   @map("underlying_type")

  raw       Json     @db.JsonB
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([segment, instrumentType, tradingSymbol], map: "idx_instruments_symbol")
  @@index([name], map: "idx_instruments_name")
  @@index([shortName], map: "idx_instruments_short_name")
  @@map("instruments")
}

enum StockResearchStatus {
  PENDING
  RUNNING
  RERUNNING
  COMPLETED
  FAILED
}

/// What a `StockResearch` row researches (stock, ETF or listed mutual fund units).
enum ResearchAssetType {
  STOCK
  ETF
  MUTUAL_FUND
}

enum StockResearchProvider {
  UPSTOX
  SERP
  FIRECRAWL
  NEWS
  AI
  INTERNAL
}

enum StockResearchResourceType {
  MARKET_DATA
  FUNDAMENTAL
  NEWS
  WEB_PAGE
  OPTIONS
  HISTORICAL
  SYNTHESIS
  OTHER
}

model StockResearch {
  id             String              @id @default(cuid())
  userId         String              @map("user_id")
  companyName    String?             @map("company_name")
  userPrompt     String?             @map("user_prompt") @db.Text
  assetType      ResearchAssetType   @default(STOCK) @map("asset_type")
  symbol         String?
  exchange       String?
  isin           String?
  instrumentKey  String?             @map("instrument_key")
  query          String              @db.Text
  status         StockResearchStatus @default(PENDING)
  runCount       Int                 @default(0) @map("run_count")
  determinerPlan Json?               @map("determiner_plan")
  report         Json?
  reportMarkdown String?             @map("report_markdown") @db.Text
  error          String?             @db.Text
  startedAt      DateTime?           @map("started_at")
  completedAt    DateTime?           @map("completed_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  loadingLogs   String[] @default([]) @map("loading_logs")

  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  resources StockResearchResource[]

  @@index([userId, createdAt])
  @@index([userId, assetType, createdAt])
  @@index([status, createdAt])
  @@index([symbol, exchange])
  @@index([isin])
  @@map("stock_researches")
}

model StockResearchResource {
  id               String                    @id @default(cuid())
  stockResearchId  String                    @map("stock_research_id")
  provider         StockResearchProvider
  type             StockResearchResourceType @map("resource_type")
  title            String?
  url              String?                   @db.Text
  externalId       String?                   @map("external_id")
  content          String?                   @db.Text
  rawData          Json?                     @map("raw_data")
  metadata         Json?
  researchSourceId String?                   @map("research_source_id") @db.Uuid
  contentHash      String?                   @map("content_hash")
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")

  stockResearch StockResearch @relation(fields: [stockResearchId], references: [id], onDelete: Cascade)

  @@unique([stockResearchId, provider, contentHash])
  @@index([stockResearchId, provider])
  @@index([stockResearchId, type])
  @@index([externalId])
  @@index([contentHash])
  @@map("stock_research_resources")
}
