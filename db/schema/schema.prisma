// Prisma loads every file in db/schema automatically.

generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String    @id @default(cuid())
  clerkId               String    @unique
  email                 String    @unique
  firstName             String?
  lastName              String?
  username              String?
  imageUrl              String?
  hasImage              Boolean   @default(false)
  primaryEmailAddressId String?
  lastSignInAt          DateTime?
  lastActiveAt          DateTime?
  banned                Boolean   @default(false)
  locked                Boolean   @default(false)
  twoFactorEnabled      Boolean   @default(false)
  locale                String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  savedStories          String[]  @default([]) @map("saved_stories") @db.Uuid

  newsRequests   NewsRequest[]
  chatSessions   ChatSession[]
  scripts        Script[]
  newsStoryVotes NewsStoryVote[]

  @@map("users")
}

enum NewsScope {
  local
  world
  both

  @@map("news_scope")
}

enum NewsRequestStatus {
  pending
  failed
  success

  @@map("news_request_status")
}

model NewsRequest {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String            @map("user_id")
  date        DateTime          @db.Date
  location    String?
  scope       NewsScope
  searchQuery Json              @map("search_query")
  status      NewsRequestStatus
  error       String?           @db.Text
  storyCount  Int               @default(5) @map("story_count")
  categories  String[]          @default([])
  customQuery String?           @map("custom_query") @db.Text
  language    String?
  sources     String[]          @default([])
  createdAt   DateTime          @default(now()) @map("created_at")
  completedAt DateTime?         @map("completed_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  stories     NewsStory[]
  loadingLogs String[]    @default([]) @map("loading_logs")

  @@index([userId])
  @@index([status])
  @@index([date])
  @@map("news_requests")
}

model NewsStory {
  id              String    @id @default(uuid()) @db.Uuid
  newsRequestId   String    @map("news_request_id") @db.Uuid
  title           String
  description     String?
  slug            String
  summary         String    @db.Text
  content         String    @db.Text
  category        String
  location        String?
  publishedAt     DateTime? @map("published_at")
  importanceScore Decimal?  @map("importance_score") @db.Decimal(10, 4)
  upvotes         Int       @default(0)
  downvotes       Int       @default(0)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  newsSourceIds   String[]  @default([]) @map("news_source_ids") @db.Uuid

  newsRequest  NewsRequest     @relation(fields: [newsRequestId], references: [id], onDelete: Cascade)
  sources      NewsSource[]
  chatSessions ChatSession[]
  votes        NewsStoryVote[]

  @@unique([newsRequestId, slug])
  @@index([newsRequestId])
  @@index([upvotes, publishedAt])
  @@map("news_stories")
}

model NewsSource {
  id             String    @id @default(uuid()) @db.Uuid
  newsStoryId    String    @map("news_story_id") @db.Uuid
  url            String    @db.Text
  domain         String
  title          String
  scrapedContent String?   @map("scraped_content") @db.Text
  publishedAt    DateTime? @map("published_at")
  sourceType     String    @map("source_type")
  createdAt      DateTime  @default(now()) @map("created_at")
  transcript     String?   @db.Text
  imageUrl       String?   @map("image_url") @db.Text

  newsStory NewsStory @relation(fields: [newsStoryId], references: [id], onDelete: Cascade)

  @@index([newsStoryId])
  @@map("news_sources")
}

enum VoteType {
  UP
  DOWN

  @@map("vote_type")
}

model NewsStoryVote {
  id          String @id @default(uuid()) @db.Uuid
  newsStoryId String @map("news_story_id") @db.Uuid
  userId      String @map("user_id")

  vote VoteType

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  newsStory NewsStory @relation(fields: [newsStoryId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([newsStoryId, userId])
  @@index([newsStoryId])
  @@index([userId])
  @@map("news_story_votes")
}

model ChatSession {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id")
  newsStoryId     String?  @map("news_story_id") @db.Uuid
  newsSourceId    String[] @default([]) @map("news_source_id") @db.Uuid
  title           String?
  topic           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  isFromNewsStory Boolean  @default(false) @map("is_from_news_story")

  user                  User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  newsStory             NewsStory?                 @relation(fields: [newsStoryId], references: [id], onDelete: SetNull)
  messages              ChatMessage[]
  researchSources       ResearchSource[]
  scripts               Script[]
  descriptionEmbeddings ChatDescriptionEmbedding[]

  @@index([userId])
  @@index([newsStoryId])
  @@map("chat_sessions")
}

model ChatMessage {
  id            String   @id @default(uuid()) @db.Uuid
  chatSessionId String   @map("chat_session_id") @db.Uuid
  role          String
  content       String   @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  scriptId      String?  @map("script_id") @db.Uuid

  chatSession ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)

  @@index([chatSessionId])
  @@map("chat_messages")
}

model ResearchSource {
  id            String   @id @default(uuid()) @db.Uuid
  chatSessionId String   @map("chat_session_id") @db.Uuid
  url           String   @db.Text
  domain        String
  title         String
  description   String?
  content       String   @db.Text
  sourceType    String   @map("source_type")
  createdAt     DateTime @default(now()) @map("created_at")

  chatSession ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)

  @@index([chatSessionId])
  @@map("research_sources")
}

model ChatDescriptionEmbedding {
  id            String                      @id @db.Uuid
  chatSessionId String                      @map("chat_session_id") @db.Uuid
  description   String                      @db.Text
  embedding     Unsupported("vector(1536)")

  chatSession ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)

  @@index([chatSessionId])
  @@map("chat_description_embeddings")
}

model Script {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id")
  chatSessionId     String   @map("chat_session_id") @db.Uuid
  title             String
  content           String   @db.Text
  durationSeconds   Int?     @map("duration_seconds")
  style             String?
  status            String
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  researchSourceIds String[] @default([]) @map("research_source_ids") @db.Uuid

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatSession ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([chatSessionId])
  @@map("scripts")
}
