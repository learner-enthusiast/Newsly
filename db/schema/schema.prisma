// Add more .prisma files in this folder (e.g. user.prisma, post.prisma).
// Prisma loads every file here automatically — no imports needed.

generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

enum PlanStatus {
  draft
  processing
  ready
  failed
  archived

  @@map("plan_status")
}

enum PlanVisibility {
  private
  public

  @@map("plan_visibility")
}

enum PlanMessageRole {
  user
  assistant

  @@map("plan_message_role")
}

enum PlaceType {
  pandal
  temple
  food
  restaurant
  cafe
  parking
  restroom
  atm
  pharmacy
  event
  other

  @@map("place_type")
}

enum PlanItemType {
  pandal
  food
  restaurant
  cafe
  parking
  restroom
  event
  custom

  @@map("plan_item_type")
}

enum ResearchRunStatus {
  queued
  running
  completed
  failed

  @@map("research_run_status")
}

enum ResearchRunType {
  initial_generation
  regeneration
  refresh

  @@map("research_run_type")
}

enum ResearchSourceType {
  google_search
  google_maps
  official
  news
  website
  blog
  other

  @@map("research_source_type")
}

enum PlaceSourceRelationshipType {
  location
  rating
  festival
  timing
  description

  @@map("place_source_relationship_type")
}

model User {
  id                    String    @id @default(cuid())
  clerkId               String    @unique
  email                 String    @unique
  firstName             String?
  lastName              String?
  username              String?
  imageUrl              String?
  hasImage              Boolean   @default(false)
  primaryEmailAddressId String?
  lastSignInAt          DateTime?
  lastActiveAt          DateTime?
  banned                Boolean   @default(false)
  locked                Boolean   @default(false)
  twoFactorEnabled      Boolean   @default(false)
  locale                String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  plans                 Plan[]

  @@map("users")
}

model Plan {

  id           String         @id @default(uuid()) @db.Uuid

  userId       String

  festivalId   String?        @db.Uuid

  slug         String

  title        String

  description  String?

  festivalName String

  city         String

  country      String

  year         Int

  status       PlanStatus

  visibility   PlanVisibility

  requestData  Json?

  weather      Json?

  createdAt    DateTime       @default(now())

  updatedAt    DateTime       @updatedAt

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  festival     FestivalKnowledge? @relation(fields: [festivalId], references: [id], onDelete: SetNull)

  messages     PlanMessage[]

  days         PlanDay[]

  researchRuns ResearchRun[]

  @@unique([userId, slug])

  @@index([festivalId])

  @@map("plans")
}

model PlanMessage {
  id          String          @id @default(uuid()) @db.Uuid
  planId      String          @db.Uuid
  role        PlanMessageRole
  content     String
  messageData Json?
  createdAt   DateTime        @default(now())
  plan        Plan            @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@map("plan_messages")
}

model PlanDay {
  id          String     @id @default(uuid()) @db.Uuid
  planId      String     @db.Uuid
  dayNumber   Int
  date        DateTime?  @db.Date
  title       String
  description String?
  startTime   DateTime?  @db.Time(3)
  endTime     DateTime?  @db.Time(3)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  plan        Plan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  items       PlanItem[]

  @@unique([planId, dayNumber])
  @@map("plan_days")
}

model Place {
  id             String        @id @default(uuid()) @db.Uuid
  name           String
  type           PlaceType
  address        String?
  city           String?
  area           String?
  latitude       Decimal?
  longitude      Decimal?
  googlePlaceId  String?       @unique
  serpDataId     String?
  rating         Decimal?
  reviewCount    Int?
  description    String?
  thumbnailUrl   String?
  hours          Json?
  metadata       Json?
  lastVerifiedAt DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  planItems      PlanItem[]
  sources        PlaceSource[]

  @@index([serpDataId])
  @@map("places")
}

model PlanItem {
  id                  String       @id @default(uuid()) @db.Uuid
  dayId               String       @db.Uuid
  placeId             String?      @db.Uuid
  type                PlanItemType
  position            Int
  titleOverride       String?
  descriptionOverride String?
  startTime           DateTime?    @db.Time(3)
  durationMinutes     Int?
  notes               String?
  snapshot            Json?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  day                 PlanDay      @relation(fields: [dayId], references: [id], onDelete: Cascade)
  place               Place?       @relation(fields: [placeId], references: [id], onDelete: SetNull)

  @@unique([dayId, position])
  @@map("plan_items")
}

model ResearchRun {
  id          String            @id @default(uuid()) @db.Uuid
  planId      String            @db.Uuid
  status      ResearchRunStatus
  runType     ResearchRunType
  startedAt   DateTime?
  completedAt DateTime?
  error       String?
  metadata    Json?
  createdAt   DateTime          @default(now())
  plan        Plan              @relation(fields: [planId], references: [id], onDelete: Cascade)
  sources     ResearchSource[]

  @@map("research_runs")
}

model ResearchSource {
  id            String              @id @default(uuid()) @db.Uuid
  researchRunId String              @db.Uuid
  url           String
  title         String?
  sourceType    ResearchSourceType
  searchQuery   String?
  snippet       String?
  content       String?
  contentHash   String?
  retrievedAt   DateTime?
  metadata      Json?
  createdAt     DateTime            @default(now())
  researchRun   ResearchRun         @relation(fields: [researchRunId], references: [id], onDelete: Cascade)
  places        PlaceSource[]

  @@map("research_sources")
}

model PlaceSource {
  placeId          String                       @db.Uuid
  sourceId         String                       @db.Uuid
  relationshipType PlaceSourceRelationshipType
  createdAt        DateTime                     @default(now())
  place            Place                        @relation(fields: [placeId], references: [id], onDelete: Cascade)
  source           ResearchSource               @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([placeId, sourceId])
  @@map("place_sources")
}

/// Stable festival reference for agents (culture, areas, search vocabulary, planning).
/// Not live research output — see `places`, `research_sources`, `plan_items`.
model FestivalKnowledge {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  slug             String   @unique
  description      String   @db.Text
  historicalFacts  Json?
  culturalContext  Json?
  planningProfile  Json?
  cities           Json?
  searchTaxonomy   Json?
  rituals          Json?
  terminology      Json?
  dateInformation  Json?
  transportProfile Json?
  crowdProfile     Json?
  foodProfile      Json?
  researchRules    Json?
  sources          Json?
  metadata         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  plans            Plan[]

  @@map("festival_knowledge")
}
