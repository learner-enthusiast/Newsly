// Prisma loads every file in db/schema automatically.

generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String    @id @default(cuid())
  clerkId               String    @unique
  email                 String    @unique
  firstName             String?
  lastName              String?
  username              String?
  imageUrl              String?
  hasImage              Boolean   @default(false)
  primaryEmailAddressId String?
  lastSignInAt          DateTime?
  lastActiveAt          DateTime?
  banned                Boolean   @default(false)
  locked                Boolean   @default(false)
  twoFactorEnabled      Boolean   @default(false)
  locale                String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  newsRequests NewsRequest[]
  chatSessions ChatSession[]
  scripts      Script[]

  @@map("users")
}

enum NewsScope {
  local
  world

  @@map("news_scope")
}

enum NewsRequestStatus {
  pending
  failed
  success

  @@map("news_request_status")
}

model NewsRequest {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id")
  date            DateTime  @db.Date
  location        String?
  scope           NewsScope
  searchQuery     Json      @map("search_query")
  status          NewsRequestStatus
  error           String?   @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")
  completedAt     DateTime? @map("completed_at")

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  stories NewsStory[]

  @@index([userId])
  @@index([status])
  @@index([date])
  @@map("news_requests")
}

model NewsStory {
  id              String    @id @default(uuid()) @db.Uuid
  newsRequestId   String    @map("news_request_id") @db.Uuid
  title           String
  description     String?
  slug            String
  summary         String    @db.Text
  content         String    @db.Text
  category        String
  location        String?
  publishedAt     DateTime? @map("published_at")
  importanceScore Decimal?  @map("importance_score") @db.Decimal(10, 4)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  newsSourceIds   String[]  @default([]) @map("news_source_ids") @db.Uuid

  newsRequest  NewsRequest   @relation(fields: [newsRequestId], references: [id], onDelete: Cascade)
  sources      NewsSource[]
  chatSessions ChatSession[]

  @@unique([newsRequestId, slug])
  @@index([newsRequestId])
  @@map("news_stories")
}

model NewsSource {
  id              String    @id @default(uuid()) @db.Uuid
  newsStoryId     String    @map("news_story_id") @db.Uuid
  url             String    @db.Text
  domain          String
  title           String
  scrapedContent  String?   @map("scraped_content") @db.Text
  publishedAt     DateTime? @map("published_at")
  sourceType      String    @map("source_type")
  createdAt       DateTime  @default(now()) @map("created_at")

  newsStory NewsStory @relation(fields: [newsStoryId], references: [id], onDelete: Cascade)

  @@index([newsStoryId])
  @@map("news_sources")
}

model ChatSession {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id")
  newsStoryId String?   @map("news_story_id") @db.Uuid
  newsSourceId String? @map("news_source_id") @db.Uuid
  title       String?
  topic       String?
  status      String
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  isFromNewsStory Boolean   @default(false) @map("is_from_news_story")

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  newsStory        NewsStory?        @relation(fields: [newsStoryId], references: [id], onDelete: SetNull)
  messages         ChatMessage[]
  researchSources  ResearchSource[]
  scripts          Script[]

  @@index([userId])
  @@index([newsStoryId])
  @@map("chat_sessions")
}

model ChatMessage {
  id            String   @id @default(uuid()) @db.Uuid
  chatSessionId String   @map("chat_session_id") @db.Uuid
  role          String
  content       String   @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  chatSession ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)

  @@index([chatSessionId])
  @@map("chat_messages")
}

model ResearchSource {
  id            String   @id @default(uuid()) @db.Uuid
  chatSessionId String   @map("chat_session_id") @db.Uuid
  url           String   @db.Text
  domain        String
  title         String
  content       String   @db.Text
  sourceType    String   @map("source_type")
  createdAt     DateTime @default(now()) @map("created_at")

  chatSession ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)

  @@index([chatSessionId])
  @@map("research_sources")
}

model Script {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id")
  chatSessionId   String   @map("chat_session_id") @db.Uuid
  title           String
  content         String   @db.Text
  durationSeconds Int?     @map("duration_seconds")
  style           String?
  status          String
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatSession ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([chatSessionId])
  @@map("scripts")
}
